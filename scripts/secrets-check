#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="${FORGE_SECRETS_DIR:-$repo_root/secrets}"
key_file="$secrets_dir/age-key.txt"
encrypted_file="$secrets_dir/local.yaml"

if [[ ! -f "$key_file" || ! -f "$encrypted_file" ]]; then
  echo "local secret fixture is missing; run 'just secrets-init' first" >&2
  exit 1
fi

decrypted_file="$(mktemp "${TMPDIR:-/tmp}/forge-secrets-check.XXXXXX")"
trap 'rm -f -- "$decrypted_file"' EXIT
SOPS_AGE_KEY_FILE="$key_file" sops --decrypt --output "$decrypted_file" "$encrypted_file"
grep -Fqx 'discourse-secret-key-base: forge-local-secret-placeholder' "$decrypted_file"

if grep -Fq 'forge-local-secret-placeholder' "$encrypted_file"; then
  echo "encrypted fixture contains plaintext" >&2
  exit 1
fi

echo "local SOPS/age fixture decrypts successfully and contains no plaintext marker"
