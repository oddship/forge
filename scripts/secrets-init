#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="${FORGE_SECRETS_DIR:-$repo_root/secrets}"
key_file="$secrets_dir/age-key.txt"
encrypted_file="$secrets_dir/local.yaml"

mkdir -p "$secrets_dir"
chmod 700 "$secrets_dir"

if [[ ! -e "$key_file" ]]; then
  age-keygen -o "$key_file" >/dev/null
  chmod 600 "$key_file"
  echo "created local age identity: $key_file"
else
  echo "using existing local age identity: $key_file"
fi

recipient="$(age-keygen -y "$key_file")"

if [[ ! -e "$encrypted_file" ]]; then
  plaintext_file="$(mktemp "${TMPDIR:-/tmp}/forge-secrets.XXXXXX.yaml")"
  trap 'rm -f -- "$plaintext_file"' EXIT
  printf '%s\n' 'discourse-secret-key-base: forge-local-secret-placeholder' >"$plaintext_file"
  sops --encrypt --age "$recipient" --output "$encrypted_file" "$plaintext_file"
  chmod 600 "$encrypted_file"
  echo "created encrypted local fixture: $encrypted_file"
else
  echo "using existing encrypted local fixture: $encrypted_file"
fi

echo "recipient: $recipient"
echo "run 'just secrets-check' to verify decryption"
