#!/usr/bin/env bash
set -euo pipefail

scratch_dir="$(mktemp -d "${TMPDIR:-/tmp}/forge-secrets-smoke.XXXXXX")"
trap 'rm -rf -- "$scratch_dir"' EXIT

key_file="$scratch_dir/age-key.txt"
plaintext_file="$scratch_dir/plain.yaml"
encrypted_file="$scratch_dir/encrypted.yaml"
decrypted_file="$scratch_dir/decrypted.yaml"

age-keygen -o "$key_file" >/dev/null
chmod 600 "$key_file"
recipient="$(age-keygen -y "$key_file")"
printf '%s\n' 'smoke-secret: forge-secret-round-trip' >"$plaintext_file"
sops --encrypt --age "$recipient" --output "$encrypted_file" "$plaintext_file"

if grep -Fq 'forge-secret-round-trip' "$encrypted_file"; then
  echo "SOPS output exposed the plaintext fixture" >&2
  exit 1
fi

SOPS_AGE_KEY_FILE="$key_file" sops --decrypt --output "$decrypted_file" "$encrypted_file"
grep -Fqx 'smoke-secret: forge-secret-round-trip' "$decrypted_file"
echo "SOPS/age local secret round-trip passed"
